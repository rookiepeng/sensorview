{
  "name": "sensorview",
  "productName": "SensorView",
  "version": "13.0.0-alpha.0",
  "description": "Desktop inspector for radar and lidar logs",
  "author": "Zhengyu Peng",
  "license": "GPL-3.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",

<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration for the .NET Framework runtime that pythonnet starts inside the
  built app, so that the native window works in a build the user downloaded.

  pywebview's Windows backend reaches WebView2 through pythonnet, which loads
  the .NET Framework runtime into this process. That runtime refuses to load an
  assembly whose file carries the Internet zone mark Windows stamps on every
  file extracted from a downloaded zip, so Python.Runtime.dll fails to load,
  pywebview finds no GUI backend, and the app opens a browser tab instead of
  its own window.

  loadFromRemoteSources lifts that restriction for this process. The default
  AppDomain reads its configuration from the file named after the executable,
  which is why this one has to sit next to sensorview.exe; sensorview.spec copies it
  there once the build has been laid out.
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
